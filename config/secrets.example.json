{
  "_comment": "Patterns that must never be committed. Copy to secrets.json and fill in. The real file is gitignored: a list of what you must not publish is also a map of what to look for.",
  "allowPaths": ["^config/secrets\\.example\\.json$", "^scripts/check-staged\\.mjs$"],
  "rules": [
    { "name": "phone number",     "pattern": "\\(?\\b\\d{3}\\)?[ .-]?\\d{3}[ .-]?\\d{4}\\b", "hint": "a personal phone number" },
    { "name": "personal email",   "pattern": "your\\.address@example\\.com",                  "hint": "your email address" },
    { "name": "tracker contents", "pattern": "\"applications\"\\s*:\\s*\\[",                  "hint": "looks like the application store" }
  ]
}
