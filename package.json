{
  "name": "alyx",
  "version": "0.1.0",
  "description": "A local job search command center. Scans public ATS boards, scores roles against your profile with Claude, keeps everything on your machine.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "scan": "node src/scan.mjs",
    "scan:new": "node src/scan.mjs --matched-only --since 7",
    "evaluate": "node src/evaluate.mjs --matched-only",
    "demo": "node src/seed.mjs",
    "demo:clear": "node src/seed.mjs --clear",
    "serve": "node src/serve.mjs",
    "canary": "node src/canary.mjs",
    "backup": "node src/backup.mjs",
    "backup:status": "node src/backup.mjs --status"
  },
  "engines": {
    "node": ">=20"
  }
}
